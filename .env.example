# ==============================================================================
# Mad-Bak Environment Variables Template (.env.example)
# Copy this file to .env and replace placeholder values with your actual credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. NODE ENVIRONMENT
# ------------------------------------------------------------------------------
NODE_ENV="development"

# ------------------------------------------------------------------------------
# 2. NEON POSTGRESQL DATABASE (https://console.neon.tech)
# ------------------------------------------------------------------------------
# [PLACEHOLDER - REQUIRED]: Obtain both strings from your Neon Project Dashboard.
# DATABASE_URL: Pooled connection string (ends with -pooler, used at runtime).
DATABASE_URL="postgresql://username:password@ep-sample-pooler.region.neon.tech/neondb?sslmode=require"

# DIRECT_URL: Direct unpooled connection string (used by Prisma CLI for migrations).
DIRECT_URL="postgresql://username:password@ep-sample.region.neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY SECRETS
# ------------------------------------------------------------------------------
# [PLACEHOLDER - REQUIRED]: High-entropy secret for signing customer/admin JWTs (min 32 chars).
# Generate using: openssl rand -base64 32
JWT_SECRET="replace-with-a-secure-random-32-character-secret-key-12345"

# [PLACEHOLDER - REQUIRED]: Secret for authenticating Vercel & GitHub Actions cron endpoints (min 16 chars).
# Generate using: openssl rand -hex 16
CRON_SECRET="replace-with-a-secure-random-cron-secret-123456"

# [PLACEHOLDER - REQUIRED]: Shared secret for the Android InstaPay push notification listener (min 16 chars).
# Must match the x-device-secret header sent by the Android listener app on the bakery phone.
DEVICE_SECRET="replace-with-device-secret-123456"

# ------------------------------------------------------------------------------
# 4. GOOGLE GEMINI VISION OCR (https://aistudio.google.com)
# ------------------------------------------------------------------------------
# [PLACEHOLDER - REQUIRED]: API key from Google AI Studio.
# Used by Gemini Multimodal Vision API (gemini-1.5-flash / gemini-2.0-flash) to extract
# IPN reference, amount, timestamp, and recipient handle from InstaPay screenshots.
GEMINI_API_KEY="AIzaSyYourActualGoogleGeminiApiKeyPlaceholder"

# ------------------------------------------------------------------------------
# 5. CLOUDINARY MEDIA STORAGE (https://cloudinary.com/console)
# ------------------------------------------------------------------------------
# [PLACEHOLDER - REQUIRED]: Credentials from your Cloudinary Dashboard.
# Used to store customer receipt screenshots and product catalog images on CDN.
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="123456789012345"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret-key"

# ------------------------------------------------------------------------------
# 6. PUBLIC APPLICATION URL
# ------------------------------------------------------------------------------
# Base URL of the deployment (used for password reset links and webhook callbacks).
# For local development: http://localhost:3000
# For production: https://mad-bak.vercel.app (or custom domain)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
